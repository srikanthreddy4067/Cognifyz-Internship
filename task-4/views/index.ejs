
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Cognifyz - Task 4 Registration</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <script src="/script.js" defer></script>
</head>
<body>
    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5">
                <div class="card shadow border-0">
                    <div class="card-body p-4">
                        <h1 class="h3 text-center">Student Registration</h1>
                        <p class="text-center text-secondary">
                            Cognifyz Internship — Task 4
                        </p>

                        <form action="/register" method="POST"
                              id="registrationForm" novalidate>

                            <div class="mb-3">
                                <label for="name" class="form-label">
                                    Full Name
                                </label>
                                <input type="text" id="name" name="name"
                                    class="form-control"
                                    value="<%= formData.name %>"
                                    placeholder="At least 3 characters">
                                <small id="nameError" class="text-danger">
                                    <%= errors.name || '' %>
                                </small>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">
                                    Email Address
                                </label>
                                <input type="text" id="email" name="email"
                                    class="form-control"
                                    value="<%= formData.email %>"
                                    placeholder="student@example.com">
                                <small id="emailError" class="text-danger">
                                    <%= errors.email || '' %>
                                </small>
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">
                                    Password
                                </label>
                                <input type="password" id="password"
                                    name="password" class="form-control"
                                    placeholder="At least 8 characters">
                                <small id="passwordError"
                                       class="text-danger">
                                    <%= errors.password || '' %>
                                </small>
                                <small id="passwordHint"
                                       class="text-secondary d-block mt-1">
                                    Use at least 8 characters.
                                </small>
                            </div>

                            <div class="mb-3">
                                <label for="confirmPassword"
                                       class="form-label">
                                    Confirm Password
                                </label>
                                <input type="password"
                                    id="confirmPassword"
                                    name="confirmPassword"
                                    class="form-control"
                                    placeholder="Re-enter your password">
                                <small id="confirmPasswordError"
                                       class="text-danger">
                                    <%= errors.confirmPassword || '' %>
                                </small>
                            </div>

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Register
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
